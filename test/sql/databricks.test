# The unified columns, types and nullability shared with the other orchestrator workers.
query TT
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'databricks' AND schema_name = 'unified' AND table_name = 'runs' ORDER BY column_index;
----
orchestrator	VARCHAR
run_id	VARCHAR
pipeline	VARCHAR
status	VARCHAR
raw_status	VARCHAR
trigger	VARCHAR
queued_at	TIMESTAMP WITH TIME ZONE
started_at	TIMESTAMP WITH TIME ZONE
ended_at	TIMESTAMP WITH TIME ZONE
duration_seconds	DOUBLE
url	VARCHAR

query TTT
SELECT column_name, data_type, is_nullable FROM duckdb_columns() WHERE database_name = 'databricks' AND schema_name = 'unified' AND table_name = 'task_runs' ORDER BY column_index;
----
orchestrator	VARCHAR	false
run_id	VARCHAR	false
task_run_id	VARCHAR	false
task_name	VARCHAR	true
status	VARCHAR	false
raw_status	VARCHAR	true
attempt	INTEGER	true
started_at	TIMESTAMP WITH TIME ZONE	true
ended_at	TIMESTAMP WITH TIME ZONE	true
duration_seconds	DOUBLE	true
url	VARCHAR	true

query TT
SELECT s, databricks.unified.unified_status(s) FROM (VALUES ('SUCCESS'), ('success_with_failures'), ('TIMEDOUT'), ('UPSTREAM_CANCELED'), ('BLOCKED'), ('INTERNAL_ERROR'), (NULL)) t(s) ORDER BY s NULLS LAST;
----
BLOCKED	queued
INTERNAL_ERROR	failed
SUCCESS	success
TIMEDOUT	failed
UPSTREAM_CANCELED	skipped
success_with_failures	success
NULL	queued
