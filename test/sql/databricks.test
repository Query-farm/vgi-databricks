# name: test/sql/databricks.test
# description: The databricks worker through DuckDB, against the strict replay in test/mock_api (ci/run-integration.sh)
# group: [databricks]

require vgi

require-env DATABRICKS_WORKER

require-env DATABRICKS_MOCK

# JSON columns (settings, details, definition) use the json extension's operators.
statement ok
LOAD json;

statement ok
ATTACH 'databricks' (TYPE vgi, LOCATION '{DATABRICKS_WORKER}');

# ---------------------------------------------------------------- catalog shape

query TT
SELECT schema_name, table_name FROM duckdb_tables() WHERE database_name = 'databricks' ORDER BY schema_name, table_name;
----
main	cluster_events
main	cluster_policies
main	clusters
main	instance_pools
main	job_run_tasks
main	job_runs
main	jobs
main	pipeline_events
main	pipeline_updates
main	pipelines
main	query_history
main	repos
main	secret_scopes
main	sql_warehouses
unified	runs
unified	task_runs

# No secret yet: a clear error, not a crash.
statement error
SELECT count(*) FROM databricks.main.jobs;
----
<REGEX>:.*no Databricks credentials.*

# A secret of the wrong shape is rejected with the field name.
statement ok
CREATE SECRET dbx_bad (TYPE databricks, HOST 'ftp://example.com', TOKEN 'x');

statement error
SELECT count(*) FROM databricks.main.jobs;
----
<REGEX>:.*HOST must be an http.*

statement ok
DROP SECRET dbx_bad;

statement ok
CREATE SECRET dbx_noauth (TYPE databricks, HOST '{DATABRICKS_MOCK}');

statement error
SELECT count(*) FROM databricks.main.jobs;
----
<REGEX>:.*set TOKEN, or CLIENT_ID and CLIENT_SECRET, or AZURE_TOKEN.*

statement ok
DROP SECRET dbx_noauth;

# A personal access token; two items per page so every listing pages through tokens.
# This replay also answers the first request to every path with 429 + Retry-After.
statement ok
CREATE SECRET dbx (TYPE databricks, HOST '{DATABRICKS_MOCK}', TOKEN 'dapi-fixture-token', PAGE_SIZE 2);

# ------------------------------------------------------------------------- jobs

query ITTTTI
SELECT job_id, name, schedule_cron, trigger_type, schedule_paused, task_count FROM databricks.main.jobs ORDER BY job_id;
----
101	nightly_etl	0 0 2 * * ?	periodic	false	3
102	flaky_report	NULL	NULL	NULL	3
103	dlt_refresh	0 30 0 * * ?	periodic	true	1
104	table_watch	NULL	table_update	false	1

# Tasks beyond the first page (the replay pages task arrays two at a time) are fetched via jobs/get.
query T
SELECT array_to_string([t.task_key || ':' || t.task_type || '@' || coalesce(t.cluster, '-') FOR t IN tasks], ' ') FROM databricks.main.jobs WHERE job_id = 101;
----
ingest:notebook@job_cluster:etl_cluster transform:spark_python@job_cluster:etl_cluster publish:sql@serverless

query TT
SELECT tags['team'], tasks[2].depends_on FROM databricks.main.jobs WHERE name = 'nightly_etl';
----
data-eng	[ingest]

query TIII
SELECT job_clusters[1].job_cluster_key, job_clusters[1].num_workers, job_clusters[1].autoscale_min_workers, job_clusters[1].autoscale_max_workers FROM databricks.main.jobs WHERE job_id = 101;
----
etl_cluster	NULL	2	8

# Secrets in job settings are masked; {{secrets/...}} references are kept.
query TTTT
SELECT settings->>'$.parameters[1].default', settings->>'$.parameters[0].default', settings->'$.job_clusters[0].new_cluster.spark_conf'->>'$."spark.hadoop.fs.s3a.secret.key"', settings->'$.job_clusters[0].new_cluster.spark_conf'->>'$."fs.azure.account.key.lake.dfs.core.windows.net"' FROM databricks.main.jobs WHERE job_id = 101;
----
***	prod	***	{{secrets/lake/account-key}}

query I
SELECT count(*) FROM databricks.main.jobs WHERE settings::VARCHAR LIKE '%hunter2%' OR settings::VARCHAR LIKE '%plaintext-fixture-secret%';
----
0

# -------------------------------------------------------------------- job runs

query IITTTTT
SELECT run_id, job_id, run_name, run_type, trigger, life_cycle_state, result_state FROM databricks.main.job_runs ORDER BY run_id;
----
2001	101	nightly_etl	JOB_RUN	PERIODIC	TERMINATED	SUCCESS
2002	101	nightly_etl	JOB_RUN	PERIODIC	TERMINATED	FAILED
2003	101	nightly_etl	JOB_RUN	PERIODIC	RUNNING	NULL
2101	102	flaky_report	JOB_RUN	ONE_TIME	TERMINATED	SUCCESS
2102	102	flaky_report	JOB_RUN	ONE_TIME	TERMINATED	CANCELED
2201	103	dlt_refresh	JOB_RUN	PERIODIC	TERMINATED	FAILED
2301	104	table_watch	JOB_RUN	TABLE	QUEUED	NULL
2401	NULL	adhoc_backfill	SUBMIT_RUN	ONE_TIME	TERMINATED	SUCCESS

query ITTTRT
SELECT run_id, start_time, end_time, termination_code, run_duration_seconds, state_message FROM databricks.main.job_runs WHERE job_id = 101 AND result_state = 'FAILED';
----
2002	2026-11-14 02:00:00+00	2026-11-14 02:25:00+00	RUN_EXECUTION_ERROR	1500.0	Task transform failed with message: Workload failed, see run output for details.

query IT
SELECT run_id, queue_reason FROM databricks.main.job_runs WHERE life_cycle_state IN ('QUEUED', 'RUNNING') ORDER BY run_id;
----
2003	NULL
2301	Queued due to reaching maximum concurrent runs on the warehouse.

query ITT
SELECT run_id, user_cancelled_or_timedout, creator_user_name FROM databricks.main.job_runs WHERE run_id = 2102;
----
2102	true	bob@example.com

# Job parameters are masked like settings.
query T
SELECT array_to_string([p.name || '=' || p.value FOR p IN job_parameters], ' ') FROM databricks.main.job_runs WHERE run_id = 2001;
----
env=prod db_password=***

query I
SELECT count(*) FROM databricks.main.job_runs WHERE start_time >= TIMESTAMPTZ '2026-11-14 00:00:00+00' AND start_time < TIMESTAMPTZ '2026-11-15 00:00:00+00';
----
4

# --------------------------------------------------------------- job run tasks

# Run 2002 has three tasks; the replay pages them two at a time (has_more → runs/get page tokens).
query ITIITT
SELECT run_id, task_key, task_run_id, attempt_number, result_state, cluster_id FROM databricks.main.job_run_tasks WHERE run_id = 2002 ORDER BY task_run_id;
----
2002	ingest	3011	0	SUCCESS	1114-020100-jc2002cd
2002	transform	3012	0	FAILED	1114-020100-jc2002cd
2002	publish	3013	0	UPSTREAM_FAILED	NULL

# Retries are separate rows.
query ITI
SELECT run_id, task_key, count(*) AS attempts FROM databricks.main.job_run_tasks GROUP BY ALL HAVING count(*) > 1 ORDER BY ALL;
----
2101	render	2

query I
SELECT count(*) FROM databricks.main.job_run_tasks;
----
19

query TTR
SELECT task_key, task_type, execution_duration_seconds FROM databricks.main.job_run_tasks WHERE task_run_id = 3002;
----
transform	spark_python	1135.0

# ------------------------------------------------------------------ run_output

query TITT
SELECT task_key, task_run_id, result_state, error FROM databricks.main.run_output(2002) ORDER BY task_run_id;
----
ingest	3011	SUCCESS	NULL
transform	3012	FAILED	AnalysisException: [TABLE_OR_VIEW_NOT_FOUND] The table or view `main`.`raw`.`orders_v2` cannot be found.
publish	3013	UPSTREAM_FAILED	NULL

# A task run id returns just that task.
query TIT
SELECT task_key, attempt_number, error_trace LIKE 'Traceback%' FROM databricks.main.run_output(3012);
----
transform	0	true

# The notebook exit value is withheld unless include_result := true; its length is always shown.
query TITT
SELECT task_key, attempt_number, notebook_result, notebook_result_truncated FROM databricks.main.run_output(2101) ORDER BY task_run_id;
----
extract	0	NULL	false
render	0	NULL	NULL
render	1	NULL	false
email	0	NULL	false

query TT
SELECT task_key, notebook_result FROM databricks.main.run_output(2101, include_result := true) WHERE attempt_number = 1;
----
render	{"rows": 42}

query IT
SELECT notebook_result_length, notebook_result IS NULL FROM databricks.main.run_output(3103);
----
12	true

# Logs are cut to max_log_chars and flagged.
query TTI
SELECT left(logs, 11), logs_truncated, length(logs) FROM databricks.main.run_output(2401, max_log_chars := 20);
----
Backfilling	true	20

query T
SELECT logs_truncated FROM databricks.main.run_output(2401);
----
false

statement error
SELECT * FROM databricks.main.run_output(999999);
----
<REGEX>:.*run 999999 does not exist.*

